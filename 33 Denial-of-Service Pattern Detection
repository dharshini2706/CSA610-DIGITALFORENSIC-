      "cell_type": "code",
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "packets = [\n",
        "    {\"src\": \"1.1.1.1\", \"dst\": \"server1\", \"time\": \"10:00:01\"},\n",
        "    {\"src\": \"2.2.2.2\", \"dst\": \"server1\", \"time\": \"10:00:01\"},\n",
        "    {\"src\": \"3.3.3.3\", \"dst\": \"server1\", \"time\": \"10:00:02\"},\n",
        "    {\"src\": \"4.4.4.4\", \"dst\": \"server1\", \"time\": \"10:00:02\"},\n",
        "    {\"src\": \"5.5.5.5\", \"dst\": \"server2\", \"time\": \"10:00:03\"},\n",
        "]\n",
        "\n",
        "dst_count = defaultdict(int)\n",
        "for p in packets:\n",
        "    dst_count[p[\"dst\"]] += 1\n",
        "\n",
        "THRESHOLD = 4\n",
        "print(\"Traffic per destination:\")\n",
        "for dst, count in dst_count.items():\n",
        "    print(dst, \"-\", count, \"packets\")\n",
        "    if count >= THRESHOLD:\n",
        "        print(\"   -> Possible DoS activity detected (high concentrated traffic)\")"
      ],
