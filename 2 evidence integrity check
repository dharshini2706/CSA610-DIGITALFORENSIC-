        "\"\"\"\n",
        "Digital Evidence Integrity Check\n",
        "Verifies a file's SHA-256 hash against a recorded value and logs\n",
        "a simple chain-of-custody record.\n",
        "\"\"\"\n",
        "\n",
        "import hashlib\n",
        "import json\n",
        "import os\n",
        "from datetime import datetime\n",
        "\n",
        "\n",
        "def calculate_hash(filepath):\n",
        "    \"\"\"Return the SHA-256 hash of a file.\"\"\"\n",
        "    sha256 = hashlib.sha256()\n",
        "    with open(filepath, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(4096), b\"\"):\n",
        "            sha256.update(chunk)\n",
        "    return sha256.hexdigest()\n",
        "\n",
        "\n",
        "# --- Evidence register (normally a real database; here a small JSON file\n",
        "#     so the original hash survives between runs of this script) ---\n",
        "REGISTER_FILE = \"evidence_register.json\"\n",
        "filename = \"evidence_file.txt\"\n",
        "\n",
        "if os.path.exists(REGISTER_FILE):\n",
        "    # Register already exists: load the hash recorded at acquisition time\n",
        "    with open(REGISTER_FILE) as f:\n",
        "        evidence_register = json.load(f)\n",
        "else:\n",
        "    # First run: create a sample evidence file and record its \"acquisition\" hash\n",
        "    if not os.path.exists(filename):\n",
        "        with open(filename, \"w\") as f:\n",
        "            f.write(\"This is the original acquired evidence content.\\n\")\n",
        "\n",
        "    evidence_register = {\n",
        "        \"evidence_id\": \"EVID-001\",\n",
        "        \"file_name\": filename,\n",
        "        \"acquisition_time\": datetime.now().isoformat(timespec=\"seconds\"),\n",
        "        \"original_hash\": calculate_hash(filename),\n",
        "    }\n",
        "    with open(REGISTER_FILE, \"w\") as f:\n",
        "        json.dump(evidence_register, f)\n",
        "    print(\"[SETUP] Created evidence file and recorded original hash in register.\\n\")\n",
        "\n",
        "# --- Verification step ---\n",
        "verification_time = datetime.now().isoformat(timespec=\"seconds\")\n",
        "current_hash = calculate_hash(filename)\n",
        "\n",
        "match = current_hash == evidence_register[\"original_hash\"]\n",
        "\n",
        "# --- Chain-of-custody record ---\n",
        "chain_of_custody = {\n",
        "    \"evidence_id\": evidence_register[\"evidence_id\"],\n",
        "    \"file_name\": filename,\n",
        "    \"acquisition_time\": evidence_register[\"acquisition_time\"],\n",
        "    \"original_hash\": evidence_register[\"original_hash\"],\n",
        "    \"verification_time\": verification_time,\n",
        "    \"current_hash\": current_hash,\n",
        "    \"status\": \"UNALTERED\" if match else \"POTENTIALLY ALTERED\",\n",
        "}\n",
        "\n",
        "# --- Output ---\n",
        "print(\"=== Chain of Custody Record ===\")\n",
        "for key, value in chain_of_custody.items():\n",
        "    print(f\"{key}: {value}\")\n",
        "\n",
        "print(\"\\n=== Result ===\")\n",
        "if match:\n",
        "    print(\"Hash matches. Evidence integrity confirmed.\")\n",
        "else:\n",
        "    print(\"WARNING: Hash mismatch! Evidence may have been altered.\")\n",
        "\n",
        "# Optionally save the record to a log file\n",
        "with open(\"chain_of_custody_log.json\", \"a\") as log:\n",
        "    log.write(json.dumps(chain_of_custody) + \"\\n\")"
