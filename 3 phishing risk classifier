        "\"\"\"\n",
        "Phishing Risk Classifier\n",
        "Scores sample emails using multiple indicators (not just one keyword)\n",
        "and classifies each as LOW, MEDIUM, or HIGH risk.\n",
        "\"\"\"\n",
        "\n",
        "import re\n",
        "\n",
        "# --- Indicator keyword lists ---\n",
        "URGENCY_WORDS = [\"urgent\", \"immediately\", \"verify now\", \"act now\",\n",
        "                  \"suspended\", \"expires\", \"final notice\", \"24 hours\"]\n",
        "\n",
        "CREDENTIAL_WORDS = [\"password\", \"login\", \"verify your account\",\n",
        "                     \"confirm your identity\", \"social security\",\n",
        "                     \"credit card\", \"update your billing\"]\n",
        "\n",
        "SUSPICIOUS_LINK_PATTERNS = [\n",
        "    r\"bit\\.ly\", r\"tinyurl\", r\"\\d+\\.\\d+\\.\\d+\\.\\d+\",  # shorteners / raw IPs\n",
        "]\n",
        "\n",
        "FREE_EMAIL_DOMAINS = [\"gmail.com\", \"yahoo.com\", \"outlook.com\"]\n",
        "\n",
        "\n",
        "def find_matches(text, word_list):\n",
        "    \"\"\"Return which words from word_list appear in text (case-insensitive).\"\"\"\n",
        "    text = text.lower()\n",
        "    return [w for w in word_list if w in text]\n",
        "\n",
        "\n",
        "def check_sender(sender, claimed_org):\n",
        "    \"\"\"Flag mismatches between sender domain and the organization it claims to be.\"\"\"\n",
        "    indicators = []\n",
        "    domain = sender.split(\"@\")[-1].lower()\n",
        "\n",
        "    if claimed_org and claimed_org.lower() not in domain:\n",
        "        indicators.append(f\"Sender domain '{domain}' does not match claimed \"\n",
        "                           f\"organization '{claimed_org}'\")\n",
        "    if domain in FREE_EMAIL_DOMAINS and claimed_org:\n",
        "        indicators.append(f\"Claims to be '{claimed_org}' but sent from a free \"\n",
        "                           f\"email provider ({domain})\")\n",
        "    return indicators\n",
        "\n",
        "\n",
        "def check_links(links):\n",
        "    \"\"\"Flag suspicious hyperlinks (shorteners, raw IPs, mismatched text).\"\"\"\n",
        "    indicators = []\n",
        "    for link in links:\n",
        "        for pattern in SUSPICIOUS_LINK_PATTERNS:\n",
        "            if re.search(pattern, link, re.IGNORECASE):\n",
        "                indicators.append(f\"Suspicious link pattern in URL: {link}\")\n",
        "                break\n",
        "    return indicators\n",
        "\n",
        "\n",
        "def score_email(email):\n",
        "    \"\"\"Combine all indicators into a weighted risk score and reasons.\"\"\"\n",
        "    indicators = []\n",
        "    score = 0\n",
        "\n",
        "    # Sender check\n",
        "    sender_flags = check_sender(email[\"sender\"], email.get(\"claimed_org\"))\n",
        "    indicators += sender_flags\n",
        "    score += len(sender_flags) * 3\n",
        "\n",
        "    # Urgency language\n",
        "    urgency_hits = find_matches(email[\"subject\"] + \" \" + email[\"body\"], URGENCY_WORDS)\n",
        "    if urgency_hits:\n",
        "        indicators.append(f\"Urgency language detected: {', '.join(urgency_hits)}\")\n",
        "        score += len(urgency_hits) * 2\n",
        "\n",
        "    # Credential requests\n",
        "    cred_hits = find_matches(email[\"body\"], CREDENTIAL_WORDS)\n",
        "    if cred_hits:\n",
        "        indicators.append(f\"Requests for credentials/sensitive info: {', '.join(cred_hits)}\")\n",
        "        score += len(cred_hits) * 4\n",
        "\n",
        "    # Suspicious links\n",
        "    link_flags = check_links(email.get(\"links\", []))\n",
        "    indicators += link_flags\n",
        "    score += len(link_flags) * 3\n",
        "\n",
        "    # Generic greeting (common phishing trait)\n",
        "    if re.search(r\"\\bdear (customer|user|member)\\b\", email[\"body\"], re.IGNORECASE):\n",
        "        indicators.append(\"Generic greeting instead of personalized name\")\n",
        "        score += 1\n",
        "\n",
        "    return score, indicators\n",
        "\n",
        "\n",
        "def classify(score):\n",
        "    if score >= 8:\n",
        "        return \"HIGH\"\n",
        "    elif score >= 4:\n",
        "        return \"MEDIUM\"\n",
        "    else:\n",
        "        return \"LOW\"\n",
        "\n",
        "\n",
        "# --- Sample email collection ---\n",
        "emails = [\n",
        "    {\n",
        "        \"id\": \"EMAIL-1\",\n",
        "        \"sender\": \"support@paypa1-secure.com\",\n",
        "        \"claimed_org\": \"PayPal\",\n",
        "        \"subject\": \"URGENT: Your account will be suspended in 24 hours\",\n",
        "        \"body\": \"Dear customer, we noticed unusual activity. Please verify your \"\n",
        "                \"account and confirm your identity immediately by clicking below.\",\n",
        "        \"links\": [\"http://bit.ly/paypal-verify\"],\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"EMAIL-2\",\n",
        "        \"sender\": \"newsletter@medium.com\",\n",
        "        \"claimed_org\": None,\n",
        "        \"subject\": \"This week's top stories\",\n",
        "        \"body\": \"Hi there, here are the top reads picked for you this week. Enjoy!\",\n",
        "        \"links\": [\"https://medium.com/digest/august\"],\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"EMAIL-3\",\n",
        "        \"sender\": \"hr.updates@gmail.com\",\n",
        "        \"claimed_org\": \"Acme Corp\",\n",
        "        \"subject\": \"Action required: update your billing password\",\n",
        "        \"body\": \"Please login and update your billing password to avoid \"\n",
        "                \"service interruption.\",\n",
        "        \"links\": [\"http://192.168.5.20/login\"],\n",
        "    },\n",
        "]\n",
        "\n",
        "# --- Run classification ---\n",
        "for email in emails:\n",
        "    score, indicators = score_email(email)\n",
        "    risk = classify(score)\n",
        "\n",
        "    print(f\"\\n=== {email['id']} ===\")\n",
        "    print(f\"Subject: {email['subject']}\")\n",
        "    print(f\"Sender:  {email['sender']}\")\n",
        "    print(f\"Risk Score: {score}  ->  Risk Level: {risk}\")\n",
        "    if indicators:\n",
        "        print(\"Detected indicators:\")\n",
        "        for reason in indicators:\n",
        "            print(f\"  - {reason}\")\n",
        "    else:\n",
        "        print(\"No significant indicators detected.\")"
