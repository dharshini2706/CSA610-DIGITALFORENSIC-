    {
      "cell_type": "code",
      "source": [
        "file_events = [\n",
        "    {\"file\": \"doc1.txt\", \"action\": \"rename\", \"new_ext\": \".locked\", \"time\": \"10:00:01\"},\n",
        "    {\"file\": \"doc2.txt\", \"action\": \"rename\", \"new_ext\": \".locked\", \"time\": \"10:00:02\"},\n",
        "    {\"file\": \"doc3.txt\", \"action\": \"modify\", \"new_ext\": \".locked\", \"time\": \"10:00:03\"},\n",
        "    {\"file\": \"doc4.txt\", \"action\": \"rename\", \"new_ext\": \".locked\", \"time\": \"10:00:04\"},\n",
        "]\n",
        "\n",
        "renamed_count = sum(1 for e in file_events if e[\"action\"] == \"rename\")\n",
        "suspicious_ext = sum(1 for e in file_events if e[\"new_ext\"] == \".locked\")\n",
        "\n",
        "score = 0\n",
        "if renamed_count >= 3:\n",
        "    score += 1\n",
        "if suspicious_ext >= 3:\n",
        "    score += 1\n",
        "\n",
        "print(\"Files renamed:\", renamed_count)\n",
        "print(\"Suspicious extension changes:\", suspicious_ext)\n",
        "print(\"Risk Score:\", score, \"/2\")\n",
        "print(\"Verdict:\", \"RANSOMWARE SUSPECTED\" if score == 2 else \"Low risk\")"
      ],
