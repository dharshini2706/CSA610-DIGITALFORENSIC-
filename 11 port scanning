      "source": [
        "from collections import defaultdict\n",
        "\n",
        "conn = [\n",
        "    (\"A\", \"H1\", 22), (\"A\", \"H1\", 23), (\"A\", \"H1\", 80),\n",
        "    (\"A\", \"H2\", 21), (\"A\", \"H3\", 21),\n",
        "    (\"B\", \"H1\", 80)\n",
        "]\n",
        "\n",
        "ports = defaultdict(set)\n",
        "hosts = defaultdict(set)\n",
        "\n",
        "for src, dst, port in conn:\n",
        "    ports[src].add(port)\n",
        "    hosts[src].add(dst)\n",
        "\n",
        "for src in ports:\n",
        "    if len(ports[src]) >= 3:\n",
        "        print(src, \"-> Vertical scan (many ports)\")\n",
        "    if len(hosts[src]) >= 2:\n",
        "        print(src, \"-> Horizontal scan (many hosts)\")"
      ]
    }
