        "\"\"\"\n",
        "DNS Reconnaissance Tool\n",
        "Given a domain name, resolves its IP address(es) and basic DNS records.\n",
        "Handles invalid/non-existent domains gracefully.\n",
        "\"\"\"\n",
        "\n",
        "import socket\n",
        "from datetime import datetime\n",
        "\n",
        "try:\n",
        "    import dns.resolver  # from the 'dnspython' package\n",
        "    HAVE_DNSPYTHON = True\n",
        "except ImportError:\n",
        "    HAVE_DNSPYTHON = False\n",
        "\n",
        "\n",
        "def resolve_ip_addresses(domain):\n",
        "    \"\"\"Return all IP addresses (A/AAAA) the domain resolves to.\"\"\"\n",
        "    try:\n",
        "        results = socket.getaddrinfo(domain, None)\n",
        "        ips = sorted(set(r[4][0] for r in results))\n",
        "        return ips, None\n",
        "    except socket.gaierror as e:\n",
        "        return [], str(e)\n",
        "\n",
        "\n",
        "def get_dns_records(domain, record_type):\n",
        "    \"\"\"Query a specific DNS record type using dnspython, if available.\"\"\"\n",
        "    if not HAVE_DNSPYTHON:\n",
        "        return None  # skip if library not installed\n",
        "    try:\n",
        "        answers = dns.resolver.resolve(domain, record_type)\n",
        "        return [str(a).strip() for a in answers]\n",
        "    except Exception:\n",
        "        return []  # no records of this type, or query failed\n",
        "\n",
        "\n",
        "def investigate_domain(domain):\n",
        "    print(f\"\\n=== DNS Investigation Report ===\")\n",
        "    print(f\"Domain queried : {domain}\")\n",
        "    print(f\"Time of query  : {datetime.now().isoformat(timespec='seconds')}\")\n",
        "\n",
        "    ips, error = resolve_ip_addresses(domain)\n",
        "\n",
        "    if error:\n",
        "        print(f\"Result         : FAILED - domain could not be resolved\")\n",
        "        print(f\"Reason         : {error}\")\n",
        "        return\n",
        "\n",
        "    print(f\"Result         : SUCCESS\")\n",
        "    print(f\"IP address(es) : {', '.join(ips)}\")\n",
        "\n",
        "    if HAVE_DNSPYTHON:\n",
        "        for record_type in [\"MX\", \"NS\", \"TXT\"]:\n",
        "            records = get_dns_records(domain, record_type)\n",
        "            if records:\n",
        "                print(f\"{record_type} records    : {', '.join(records)}\")\n",
        "            else:\n",
        "                print(f\"{record_type} records    : none found\")\n",
        "    else:\n",
        "        print(\"(Install 'dnspython' with: pip install dnspython  \"\n",
        "              \"to also retrieve MX, NS, and TXT records)\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    domain = input(\"Enter a domain name to investigate: \").strip()\n",
        "    investigate_domain(domain)"
