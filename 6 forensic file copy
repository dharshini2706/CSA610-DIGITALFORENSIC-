        "\"\"\"\n",
        "Digital Forensic Investigation Guide\n",
        "Walks an investigator through the 5 major stages:\n",
        "Identification -> Preservation -> Collection -> Examination & Analysis -> Reporting\n",
        "Then generates a structured summary linking what happened at each stage.\n",
        "\"\"\"\n",
        "\n",
        "from datetime import datetime\n",
        "\n",
        "case = {}  # stores everything entered, keyed by stage\n",
        "\n",
        "\n",
        "def ask(prompt):\n",
        "    return input(f\"  {prompt}: \").strip()\n",
        "\n",
        "\n",
        "def stage_identification():\n",
        "    print(\"\\n--- Stage 1: Identification ---\")\n",
