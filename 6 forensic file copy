        "\"\"\"\n",
        "Forensic File Duplication Tool\n",
        "Creates an exact binary copy of an evidence file, then verifies the\n",
        "duplicate against the original using file size and SHA-256 hash.\n",
        "\"\"\"\n",
        "\n",
        "import hashlib\n",
        "import os\n",
        "\n",
        "BLOCK_SIZE = 4096  # read/write in 4KB blocks\n",
        "\n",
        "\n",
        "def calculate_hash(filepath):\n",
        "    \"\"\"Compute the SHA-256 hash of a file.\"\"\"\n",
        "    sha256 = hashlib.sha256()\n",
        "    with open(filepath, \"rb\") as f:\n",
        "        while True:\n",
        "            block = f.read(BLOCK_SIZE)\n",
        "            if not block:\n",
        "                break\n",
        "            sha256.update(block)\n",
        "    return sha256.hexdigest()\n",
        "\n",
        "\n",
        "def create_forensic_copy(source_path, copy_path):\n",
        "    \"\"\"Copy a file byte-for-byte in binary mode, without altering data.\"\"\"\n",
        "    with open(source_path, \"rb\") as src, open(copy_path, \"wb\") as dst:\n",
        "        while True:\n",
        "            block = src.read(BLOCK_SIZE)\n",
        "            if not block:\n",
        "                break\n",
        "            dst.write(block)\n",
        "\n",
        "\n",
        "def verify_copy(source_path, copy_path):\n",
        "    \"\"\"Compare size and hash of source and copy; report if they match.\"\"\"\n",
        "    source_size = os.path.getsize(source_path)\n",
        "    copy_size = os.path.getsize(copy_path)\n",
        "\n",
        "    source_hash = calculate_hash(source_path)\n",
        "    copy_hash = calculate_hash(copy_path)\n",
        "\n",
        "    size_match = source_size == copy_size\n",
        "    hash_match = source_hash == copy_hash\n",
        "\n",
        "    return {\n",
        "        \"source_size\": source_size,\n",
        "        \"copy_size\": copy_size,\n",
        "        \"size_match\": size_match,\n",
        "        \"source_hash\": source_hash,\n",
        "        \"copy_hash\": copy_hash,\n",
        "        \"hash_match\": hash_match,\n",
        "        \"exact_copy\": size_match and hash_match,\n",
        "    }\n",
        "\n",
        "\n",
        "def main():\n",
        "    source_path = input(\"Enter path of the evidence file to copy: \").strip()\n",
        "    copy_path = source_path + \".forensic_copy\"\n",
        "\n",
        "    if not os.path.isfile(source_path):\n",
        "        print(f\"Error: '{source_path}' not found.\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\nCreating forensic copy of '{source_path}' -> '{copy_path}' ...\")\n",
        "    create_forensic_copy(source_path, copy_path)\n",
        "    print(\"Copy complete.\\n\")\n",
        "\n",
        "    print(\"Verifying copy against original ...\")\n",
        "    result = verify_copy(source_path, copy_path)\n",
        "\n",
        "    print(\"\\n=== Verification Report ===\")\n",
        "    print(f\"Original file : {source_path}\")\n",
        "    print(f\"Copy file     : {copy_path}\")\n",
        "    print(f\"Original size : {result['source_size']} bytes\")\n",
        "    print(f\"Copy size     : {result['copy_size']} bytes\")\n",
        "    print(f\"Size match    : {result['size_match']}\")\n",
        "    print(f\"Original hash : {result['source_hash']}\")\n",
        "    print(f\"Copy hash     : {result['copy_hash']}\")\n",
        "    print(f\"Hash match    : {result['hash_match']}\")\n",
        "\n",
        "    print(\"\\nResult:\", \"EXACT COPY VERIFIED\" if result[\"exact_copy\"]\n",
        "          else \"COPY DOES NOT MATCH ORIGINAL - INTEGRITY FAILURE\")\n",
        "\n",
