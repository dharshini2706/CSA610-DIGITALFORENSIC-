        "authorized_devices = [\"USB1234\", \"USB5678\"]\n",
        "\n",
        "usb_events = [\n",
        "    {\"device\": \"USB1234\", \"user\": \"alice\", \"time\": \"2026-01-01 10:00\"},\n",
        "    {\"device\": \"USB9999\", \"user\": \"bob\",   \"time\": \"2026-01-02 15:00\"},\n",
        "    {\"device\": \"USB5678\", \"user\": \"alice\", \"time\": \"2026-01-03 09:30\"},\n",
        "]\n",
        "\n",
        "print(\"USB Connection Report:\")\n",
        "unauthorized = []\n",
        "for e in usb_events:\n",
        "    status = \"Authorized\" if e[\"device\"] in authorized_devices else \"UNAUTHORIZED\"\n",
        "    print(e[\"device\"], \"-\", e[\"user\"], \"-\", e[\"time\"], \"-\", status)\n",
        "    if status == \"UNAUTHORIZED\":\n",
        "        unauthorized.append(e)\n",
        "\n",
        "print(\"\\nSummary of unrecognized USB devices:\")\n",
        "for e in unauthorized:\n",
        "    print(e[\"device\"], \"used by\", e[\"user\"], \"at\", e[\"time\"])"
      ],
