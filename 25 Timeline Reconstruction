        "from collections import defaultdict\n",
        "\n",
        "events = [\n",
        "    {\"user\": \"admin\", \"src\": \"10.0.0.5\", \"result\": \"fail\"},\n",
        "    {\"user\": \"admin\", \"src\": \"10.0.0.5\", \"result\": \"fail\"},\n",
        "    {\"user\": \"admin\", \"src\": \"10.0.0.5\", \"result\": \"fail\"},\n",
        "    {\"user\": \"john\",  \"src\": \"10.0.0.9\", \"result\": \"fail\"},\n",
        "    {\"user\": \"john\",  \"src\": \"10.0.0.9\", \"result\": \"success\"},\n",
        "]\n",
        "\n",
        "fail_count = defaultdict(int)\n",
        "\n",
        "for e in events:\n",
        "    if e[\"result\"] == \"fail\":\n",
        "        fail_count[(e[\"user\"], e[\"src\"])] += 1\n",
        "\n",
        "THRESHOLD = 3\n",
        "print(\"Accounts/sources exceeding threshold:\")\n",
        "for (user, src), count in fail_count.items():\n",
        "    if count >= THRESHOLD:\n",
        "        print(user, src, \"- Failures:\", count)"
      ],
