        "!pip install python-whois -q\n",
        "\n",
        "import whois\n",
        "import datetime\n",
        "\n",
        "domain = \"google.com\"\n",
        "\n",
        "try:\n",
        "    info = whois.whois(domain)\n",
        "    print(\"Domain     :\", domain)\n",
        "    print(\"Registrar  :\", info.registrar)\n",
        "    print(\"Created On :\", info.creation_date)\n",
        "    print(\"Expires On :\", info.expiration_date)\n",
        "    print(\"Name Servers:\", info.name_servers)\n",
        "    print(\"Status     :\", info.status)\n",
        "    print(\"Collected at:\", datetime.datetime.now())\n",
        "except Exception as e:\n",
        "    print(\"WHOIS lookup failed:\", e)"
