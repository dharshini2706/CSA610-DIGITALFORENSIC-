      ],
      "source": [
        "logs = [\n",
        "    {\"file\": \"report.docx\", \"user\": \"alice\", \"time\": \"2026-01-05 09:00\"},\n",
        "    {\"file\": \"budget.xlsx\", \"user\": \"bob\",   \"time\": \"2026-01-06 11:30\"},\n",
        "    {\"file\": \"notes.txt\",   \"user\": \"alice\", \"time\": \"2026-01-04 08:15\"},\n",
        "]\n",
        "\n",
        "# sort newest first\n",
        "logs.sort(key=lambda x: x[\"time\"], reverse=True)\n",
        "\n",
        "print(\"Recently accessed files (newest first):\")\n",
        "for entry in logs:\n",
        "    print(entry[\"time\"], \"-\", entry[\"file\"], \"by\", entry[\"user\"])\n",
        "\n",
        "print(\"\\nFiles accessed by alice:\")\n",
        "for entry in logs:\n",
        "    if entry[\"user\"] == \"alice\":\n",
        "        print(entry[\"file\"], \"-\", entry[\"time\"])"
      ]
    }
