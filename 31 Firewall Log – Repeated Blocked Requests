      "cell_type": "code",
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "firewall_logs = [\n",
        "    {\"src\": \"10.0.0.5\", \"dst_port\": 22, \"action\": \"blocked\", \"time\": \"10:00\"},\n",
        "    {\"src\": \"10.0.0.5\", \"dst_port\": 22, \"action\": \"blocked\", \"time\": \"10:01\"},\n",
        "    {\"src\": \"10.0.0.5\", \"dst_port\": 22, \"action\": \"blocked\", \"time\": \"10:02\"},\n",
        "    {\"src\": \"10.0.0.9\", \"dst_port\": 443, \"action\": \"allowed\", \"time\": \"10:03\"},\n",
        "]\n",
        "\n",
        "blocked_count = defaultdict(int)\n",
        "\n",
        "for log in firewall_logs:\n",
        "    if log[\"action\"] == \"blocked\":\n",
        "        blocked_count[(log[\"src\"], log[\"dst_port\"])] += 1\n",
        "\n",
        "print(\"Repeated Blocked Access Attempts:\")\n",
        "for (src, port), count in blocked_count.items():\n",
        "    if count >= 3:\n",
        "        print(src, \"-> port\", port, \"- Blocked\", count, \"times\")"
