      "source": [
        "log = [\n",
        "    {\"time\": \"10:00:00\", \"type\": \"process\", \"detail\": \"unknown.exe started\"},\n",
        "    {\"time\": \"10:00:05\", \"type\": \"file\", \"detail\": \"doc1.txt renamed to doc1.locked\"},\n",
        "    {\"time\": \"10:00:10\", \"type\": \"file\", \"detail\": \"doc2.txt renamed to doc2.locked\"},\n",
        "    {\"time\": \"10:00:15\", \"type\": \"network\", \"detail\": \"connection to external IP\"},\n",
        "]\n",
        "\n",
        "log.sort(key=lambda x: x[\"time\"])\n",
        "\n",
        "print(\"Incident Timeline:\")\n",
        "for entry in log:\n",
        "    print(entry[\"time\"], \"|\", entry[\"type\"], \"|\", entry[\"detail\"])\n",
        "\n",
        "print(\"\\nEarliest suspicious event:\", log[0][\"detail\"], \"at\", log[0][\"time\"])\n",
        "print(\"Final observed activity:\", log[-1][\"detail\"], \"at\", log[-1][\"time\"])"
      ],
