        "]\n",
        "\n",
        "print(\"Threat Intel Matches:\")\n",
        "for ip in threat_ips:\n",
        "    matches = [l for l in logs if l[\"src\"] == ip]\n",
        "    if matches:\n",
        "        print(f\"\\nFlagged IP: {ip}\")\n",
        "        print(\"Events:\", len(matches))\n",
        "        print(\"Destinations:\", [m[\"dst\"] for m in matches])\n",
        "        print(\"Ports:\", [m[\"port\"] for m in matches])\n",
        "        print(\"Times:\", [m[\"time\"] for m in matches])"
